<item>
<entry>1</entry>
<IPA_transcription>pɛʁ lubɛrtyʁ de la kaso</IPA_transcription>
<gloss>(poem with 5 stanzas; no gloss found within accompanying document)</gloss>
</item>

<item>
<entry>2</entry>
<IPA_transcription>øn dʒuːr davust ke fazje kau</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>3</entry>
<IPA_transcription>høbeʁ avje fa kanbo laso</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>4</entry>
<IPA_transcription>pɛʁ kouse jʒa li pɛʁdigau</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>5</entry>
<IPA_transcription>avje baʁula sy li muʁo</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>6</entry>
<IPA_transcription>eskala li gʁos ʁukau</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>7</entry>
<IPA_transcription>din la plano avje fa ke kuʁ</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>8</entry>
<IPA_transcription>senzge tya un daʁangau</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>9</entry>
<IPA_transcription>kan su la fin de la dʒuʁnado</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>10</entry>
<IPA_transcription>vej suzyn pin, lon du dʁajou</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>11</entry>
<IPA_transcription>un ouseu vɛʁ dʒøstapoʁtado</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>12</entry>
<IPA_transcription>lu viz e vlan lu vaki osou</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>13</entry>
<IPA_transcription>(no transcription for fourth stanza)</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>14</entry>
<IPA_transcription>høbeʁ ke tʁemolo e ke syzo</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>15</entry>
<IPA_transcription>li dis en levan sun kapeu</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>16</entry>
<IPA_transcription>peʁdon musø, vu fouteskyzo,</IPA_transcription>
<gloss></gloss>
</item>

<item>
<entry>17</entry>
<IPA_transcription>vuzavju prɛs pɛʁ un ouseu</IPA_transcription>
<gloss></gloss>
</item>
